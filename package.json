{
  "name": "preppulse",
  "version": "0.1.0",
  "description": "Practice exams with a camera-based pressure map: how your pulse and breathing respond, question by question, compared with your own baseline. Not a medical device.",
  "license": "MIT",
  "repository": "https://github.com/tusharshah21/preppulse",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "install-electron",
    "probe": "node scripts/probe.js",
    "test": "node --test",
    "simulate": "node scripts/make-simulated-recording.js",
    "netwatch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/netwatch.ps1"
  },
  "type": "commonjs",
  "dependencies": {
    "@smartspectra/node-sdk": "^3.5.0"
  },
  "devDependencies": {
    "electron": "45.3.3"
  },
  "private": true
}
